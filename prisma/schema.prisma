generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
  publisher
}

enum MediaType {
  image
  video
}

enum UserStatus {
  attending
  interested
  none
}

enum ImageType {
  event
  gallery
}

enum ImageStatus {
  pending
  approved
  rejected
}

model User {
  id           String    @id @default(uuid())
  name         String?
  lastName     String?
  birthdate    DateTime?
  gender       String?
  username     String    @unique
  description  String?
  email        String    @unique
  password     String
  refreshToken String? // para almacenar el último refresh token válido
  avatar       String?
  location     String?
  phone        String?
  isVerified   Boolean   @default(false)

  role      Role     @default(user)
  createdAt DateTime @default(now())
  Event     Event[]

  following         Follow[]           @relation("FollowingRelation")
  followers         Follow[]           @relation("FollowerRelation")
  EventInterest     EventInterest[]
  savedEvents       SavedEvent[]
  Ticket            Ticket[]
  EventAttendance   EventAttendance[]
  eventImages       EventImage[]
  categories        Category[]         @relation("UserCategories")
  verificationCodes VerificationCode[]
  accessAssignments EventAccessAssignment[]
  admissionPasses AdmissionPass[] @relation("PassOwner")
  redeemedPasses AdmissionPass[] @relation("PassRedeemer")
  admissionScans AdmissionScan[]
}

model VerificationCode {
  id        String    @id @default(uuid())
  userId    String
  code      String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id    String  @id @default(uuid())
  name  String
  Event Event[]
  users User[]  @relation("UserCategories")
}

model Event {
  id          String     @id @default(uuid())
  slug        String     @unique
  title       String
  description String
  mediaType   MediaType
  mediaUrl    String
  cost        Float
  currency    String     @default("USA")
  gallery     String[]   @default([])
  location    String
  lat         Float?
  log         Float?
  eventDate   DateTime
  attendees   Int
  userStatus  UserStatus @default(none)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relaciones
  user   User   @relation(fields: [userId], references: [id])
  userId String

  category         Category          @relation(fields: [categoryId], references: [id])
  categoryId       String
  EventInterest    EventInterest[]
  savedBy          SavedEvent[]
  TicketItem       TicketItem[]
  EventImage       EventImage[]
  EventAttendance  EventAttendance[]
  eventTicketTypes EventTicketType[]
  accessAssignments EventAccessAssignment[]
  admissionPasses AdmissionPass[]
  admissionScans AdmissionScan[]
}

model EventImage {
  id     Int         @id @default(autoincrement())
  url    String
  type   ImageType   @default(event)
  status ImageStatus @default(pending)

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())
}

model EventTicketType {
  id         String    @id @default(uuid())
  name       String
  price      Float
  quantity   Int
  validUntil DateTime?

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Follow {
  id         String @id @default(uuid())
  follower   User   @relation("FollowingRelation", fields: [followerId], references: [id])
  followerId String

  following   User   @relation("FollowerRelation", fields: [followingId], references: [id])
  followingId String

  createdAt DateTime @default(now())

  @@unique([followerId, followingId]) // evita duplicados
}

model EventInterest {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  event     Event    @relation(fields: [eventId], references: [id])
  eventId   String
  createdAt DateTime @default(now())

  @@unique([userId, eventId]) // 👈 evita duplicados
}

model SavedEvent {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, createdAt])
}

model EventAttendance {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  createdAt DateTime @default(now())

  pass AdmissionPass?
  @@unique([userId, eventId]) // evita duplicados
}

model Ticket {
  id           String    @id @default(uuid())
  subTotal     Float
  tax          Float
  total        Float
  itemsInOrder Int
  isPaid       Boolean   @default(false)
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relaciones
  user   User   @relation(fields: [userId], references: [id])
  userId String

  transactionId String?
  billingData   Json?
  termsVersion  String?
  termsAcceptedAt DateTime?
  TicketItem    TicketItem[]
  payment       PaymentAttempt?
  settlement    TicketSettlement?
}

model TicketItem {
  id       String @id @default(uuid())
  quantity Int
  price    Float

  ticket   Ticket @relation(fields: [ticketId], references: [id])
  ticketId String

  event   Event  @relation(fields: [eventId], references: [id])
  eventId String

  eventTicketTypeId String?
  passes AdmissionPass[]
}

model PaymentAttempt {
  id              String   @id @default(uuid())
  ticketId        String   @unique
  ticket          Ticket   @relation(fields: [ticketId], references: [id])
  providerId      String?  @unique
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TicketSettlement {
  id                          String   @id @default(uuid())
  ticketId                    String   @unique
  ticket                      Ticket   @relation(fields: [ticketId], references: [id])
  organizerId                 String
  eventId                     String
  currency                    String
  ticketSubtotalCents         Int
  ticketTaxCents              Int
  buyerTotalCents             Int
  commissionRate              Decimal  @db.Decimal(9, 6)
  commissionTaxRate           Decimal  @db.Decimal(9, 6)
  processingRate              Decimal  @db.Decimal(9, 6)
  processingTaxRate           Decimal  @db.Decimal(9, 6)
  commissionCents             Int
  commissionTaxCents          Int
  estimatedProcessingCents    Int
  actualProcessingCents       Int?
  actualProcessingRecordedAt  DateTime?
  actualProcessingRecordedBy  String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([organizerId, eventId])
}

model SettlementConfig {
  id                String   @id
  commissionRate    Decimal  @db.Decimal(9, 6)
  commissionTaxRate Decimal  @db.Decimal(9, 6)
  processingRate    Decimal  @db.Decimal(9, 6)
  processingTaxRate Decimal  @db.Decimal(9, 6)
  updatedBy         String
  updatedAt         DateTime @updatedAt
}

model EventAccessAssignment {
  id         String    @id @default(uuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@unique([eventId, userId])
  @@index([userId, status])
}

model AdmissionPass {
  id           String           @id @default(uuid())
  token        String           @unique @default(uuid())
  eventId      String
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("PassOwner", fields: [userId], references: [id], onDelete: Cascade)
  ticketItemId String?
  ticketItem   TicketItem?      @relation(fields: [ticketItemId], references: [id], onDelete: Cascade)
  unitIndex    Int?
  attendanceId String?          @unique
  attendance   EventAttendance? @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  redeemedAt   DateTime?
  redeemedBy   String?
  redeemer     User?            @relation("PassRedeemer", fields: [redeemedBy], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  scans        AdmissionScan[]

  @@unique([ticketItemId, unitIndex])
  @@index([userId, eventId])
}

model AdmissionScan {
  id        String   @id @default(uuid())
  eventId   String
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User           @relation(fields: [actorId], references: [id], onDelete: Restrict)
  passId    String?
  pass      AdmissionPass? @relation(fields: [passId], references: [id], onDelete: SetNull)
  result    String
  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   @default("info") // info | warning | error | success
  userId    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
